diff --git a/h3_refine.c b/h3_refine.c
new file mode 100644
index 0000000..6d7c128
--- /dev/null
+++ b/h3_refine.c
@@ -0,0 +1,79 @@
+/* FaceRefine's video seed + truncated scheduler, for the native Metal engine.
+ * Temporal packing follows comfy/ldm/minimax/vae.py: 17-frame clips, pad the
+ * last clip, concatenate five latents per clip, then drop the last three. */
+#include "h3_refine.h"
+#include "h3_ffmpeg.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int h3_refine_schedule(int steps, float strength, h3_sigma_schedule *schedule) {
+    if (!schedule || steps < 2 || steps > 50 || !isfinite(strength) ||
+        strength < 0.01f || strength > 0.15f) return 0;
+    int total = (int)ceil((double)steps / strength);
+    /* Build the discarded prefix algebraically, without a 5,000-step buffer.
+     * Audio keeps the full serving grid; the real track is an ordered reference
+     * and is copied back by the compositor, not regenerated in the output. */
+    if (!h3_serving_schedule_build(steps, schedule)) return 0;
+    for (int i = 0; i <= steps; i++) {
+        float base = (float)(steps - i) / (float)total;
+        schedule->video[i] = (float)H3_VIDEO_SIGMA_SHIFT * base /
+            (1.0f + ((float)H3_VIDEO_SIGMA_SHIFT - 1.0f) * base);
+    }
+    return 1;
+}
+
+int h3_refine_encode(const char *vae, const char *source, int width, int height,
+                     int frames, h3_video_encoder_progress progress, void *opaque,
+                     h3_video_latent *output, char *error, size_t error_size) {
+    float *pixels = NULL;
+    int actual = 0;
+    memset(output, 0, sizeof(*output));
+    if (!h3_ffmpeg_read_video_f32(source, width, height, frames, &pixels,
+                                  &actual, error, error_size)) return 0;
+    if (actual != frames) {
+        snprintf(error, error_size, "refinement source must contain exactly %d aligned frames (got %d)", frames, actual);
+        free(pixels); return 0;
+    }
+    size_t area = (size_t)width * (size_t)height;
+    size_t latent_area = area / 256;
+    int chunks = (frames + 16) / 17;
+    int target_t = chunks * 5 - 3;
+    float *values = calloc(24 * (size_t)target_t * latent_area, sizeof(float));
+    float *clip = malloc(3 * 17 * area * sizeof(float));
+    int ok = values && clip;
+    if (!ok) snprintf(error, error_size, "out of memory staging refinement video");
+    for (int index = 0; ok && index < chunks; index++) {
+        for (int c = 0; c < 3; c++)
+            for (int t = 0; t < 17; t++) {
+                int frame = index * 17 + t;
+                if (frame >= frames) frame = frames - 1;
+                memcpy(clip + ((size_t)c * 17 + (size_t)t) * area,
+                       pixels + ((size_t)c * (size_t)frames + (size_t)frame) * area,
+                       area * sizeof(float));
+            }
+        h3_video_latent part = {0};
+        ok = h3_video_vae_encode(vae, "h3_shaders.metal", clip, 17, height,
+                                 width, NULL, NULL, &part, error, error_size);
+        if (ok && (part.time != 5 || part.height != height/16 || part.width != width/16)) {
+            snprintf(error, error_size, "refinement VAE produced unexpected geometry");
+            ok = 0;
+        }
+        if (ok)
+            for (int c = 0; c < 24; c++) {
+                int count = target_t - index * 5;
+                if (count > 5) count = 5;
+                memcpy(values + ((size_t)c * (size_t)target_t + (size_t)index * 5) * latent_area,
+                       part.values + (size_t)c * 5 * latent_area,
+                       (size_t)count * latent_area * sizeof(float));
+            }
+        h3_video_latent_free(&part);
+        if (ok && progress) progress(index + 1, chunks, opaque);
+    }
+    free(pixels); free(clip);
+    if (!ok) {free(values); return 0;}
+    output->values = values; output->time = target_t;
+    output->height = height / 16; output->width = width / 16;
+    return 1;
+}
