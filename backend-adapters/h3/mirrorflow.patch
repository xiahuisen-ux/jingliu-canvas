diff --git a/h3_worker.m b/h3_worker.m
new file mode 100644
index 0000000..62dc79f
--- /dev/null
+++ b/h3_worker.m
@@ -0,0 +1,215 @@
+/* Local JSON-lines transport for the existing h3.c cache API.
+ * stdout/stderr share one ordered pipe; only prefixed JSON is protocol data.
+ * No weights are loaded until a validated generate request arrives. */
+#import <Foundation/Foundation.h>
+#include "h3.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define REQUEST_LIMIT (1024 * 1024)
+
+static void emit(NSDictionary *event) {
+    NSData *data = [NSJSONSerialization dataWithJSONObject:event options:0 error:NULL];
+    fputs("@h3-worker@", stdout);
+    fwrite(data.bytes, 1, data.length, stdout);
+    fputc('\n', stdout);
+    fflush(stdout);
+}
+
+static NSDictionary *cache_info(h3_ctx *ctx) {
+    h3_cache_info info;
+    h3_cache_get_info(ctx, &info);
+    return @{ @"embedding_entries": @(info.embedding_entries),
+              @"embedding_bytes": @(info.embedding_bytes),
+              @"prepared_dit": @(info.prepared_dit),
+              @"video_decoder": @(info.video_decoder) };
+}
+
+static BOOL string_value(id value, BOOL required) {
+    return [value isKindOfClass:NSString.class] && (!required || [value length]) &&
+        [value rangeOfString:[NSString stringWithFormat:@"%C", (unichar)0]].location == NSNotFound;
+}
+
+static BOOL number_value(id value, double low, double high, BOOL integer) {
+    if (![value isKindOfClass:NSNumber.class] ||
+        CFGetTypeID((__bridge CFTypeRef)value) == CFBooleanGetTypeID()) return NO;
+    double n = [value doubleValue];
+    return isfinite(n) && n >= low && n <= high && (!integer || floor(n) == n);
+}
+
+static NSString *parse_request(NSDictionary *request, h3_params *params,
+                               h3_reference refs[12]) {
+    if (!string_value(request[@"prompt"], YES) ||
+        !string_value(request[@"output"], YES)) return @"prompt/output must be nonempty strings without NUL";
+    if (![request[@"output"] isAbsolutePath]) return @"output must be absolute";
+    if (!number_value(request[@"width"], 32, 1344, YES) ||
+        !number_value(request[@"height"], 32, 1344, YES) ||
+        !number_value(request[@"seconds"], 0.5, 15, NO) ||
+        !number_value(request[@"steps"], 4, 50, YES) ||
+        !number_value(request[@"seed"], 0, 9007199254740991.0, YES)) return @"invalid generation parameters";
+    params->width = [request[@"width"] intValue];
+    params->height = [request[@"height"] intValue];
+    if (params->width % 32 || params->height % 32 ||
+        params->width * params->height > 768 * 1344) return @"invalid canvas";
+    params->frames = (int)llround([request[@"seconds"] doubleValue] * 24.0);
+    params->steps = [request[@"steps"] intValue];
+    if (request[@"layers"]) {
+        if (!number_value(request[@"layers"], 45, 50, YES) ||
+            ![@[@45, @50] containsObject:request[@"layers"]]) return @"layers must be 45 or 50";
+        params->dit_layers = [request[@"layers"] intValue];
+    }
+    if (request[@"reuse"]) {
+        if (!number_value(request[@"reuse"], 1, 2, YES)) return @"reuse must be 1 or 2";
+        params->denoise_reuse = [request[@"reuse"] intValue];
+    }
+    if (params->steps < 8 && params->denoise_reuse > 1) return @"4-7 steps require reuse 1";
+    if (request[@"reference_video_max_pixels"]) {
+        id cap = request[@"reference_video_max_pixels"];
+        if (!number_value(cap, 0, 589824, YES) ||
+            ![@[@0, @147456, @358400, @589824] containsObject:cap]) return @"invalid reference video cap";
+        params->reference_video_max_pixels = [cap intValue];
+    }
+    params->seed = [request[@"seed"] unsignedLongLongValue];
+    params->output_path = [request[@"output"] UTF8String];
+    if (![request[@"ssd_streaming"] isKindOfClass:NSNumber.class] ||
+        CFGetTypeID((__bridge CFTypeRef)request[@"ssd_streaming"]) != CFBooleanGetTypeID())
+        return @"ssd_streaming must be boolean";
+    params->ssd_streaming = [request[@"ssd_streaming"] boolValue];
+    id refine = request[@"refine_source"];
+    if (refine && refine != NSNull.null) {
+        if (!string_value(refine, YES) || ![refine isAbsolutePath] ||
+            !number_value(request[@"refine_denoise"], 0.01, 0.15, NO))
+            return @"invalid refinement source/denoise";
+        params->refine_video = [refine UTF8String];
+        params->refine_denoise = [request[@"refine_denoise"] floatValue];
+    }
+    for (NSString *name in @[@"first_frame", @"last_frame"]) {
+        id path = request[name];
+        if (!path || path == NSNull.null) continue;
+        if (!string_value(path, YES) || ![path isAbsolutePath]) return @"invalid anchor path";
+        if ([name isEqualToString:@"first_frame"]) params->first_frame = [path UTF8String];
+        else params->last_frame = [path UTF8String];
+    }
+    NSArray *references = request[@"references"];
+    if (![references isKindOfClass:NSArray.class] || references.count > 12) return @"invalid references";
+    if (references.count && (params->first_frame || params->last_frame)) return @"anchors and references cannot be combined";
+    for (NSUInteger index = 0; index < references.count; index++) {
+        id ref = references[index];
+        if (![ref isKindOfClass:NSDictionary.class] || !string_value(ref[@"path"], YES) ||
+            ![ref[@"path"] isAbsolutePath]) return @"invalid reference path";
+        NSString *kind = ref[@"kind"];
+        if (![kind isKindOfClass:NSString.class]) return @"invalid reference kind";
+        if ([kind isEqualToString:@"image"]) refs[index].kind = H3_REFERENCE_IMAGE;
+        else if ([kind isEqualToString:@"audio"]) refs[index].kind = H3_REFERENCE_AUDIO;
+        else if ([kind isEqualToString:@"video"] || [kind isEqualToString:@"silent_video"]) {
+            refs[index].kind = H3_REFERENCE_VIDEO;
+            refs[index].include_embedded_audio = [kind isEqualToString:@"video"];
+        } else return @"unsupported reference kind";
+        refs[index].path = [ref[@"path"] UTF8String];
+    }
+    params->references = refs;
+    params->reference_count = references.count;
+    return nil;
+}
+
+static int progress(const char *phase, int completed, int total, void *opaque) {
+    NSString *request_id = (__bridge NSString *)opaque;
+    emit(@{@"event": @"progress", @"id": request_id,
+           @"phase": [NSString stringWithUTF8String:phase],
+           @"completed": @(completed), @"total": @(total)});
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    @autoreleasepool {
+        BOOL validate_only = argc == 2 && !strcmp(argv[1], "--validate");
+        if (argc != 2) {
+            fprintf(stderr, "Usage: h3-worker MODEL_DIR | --validate\n");
+            return 2;
+        }
+        setvbuf(stdout, NULL, _IONBF, 0);
+        setvbuf(stderr, NULL, _IONBF, 0);
+        setenv("H3_PROFILE", "1", 1);
+        h3_ctx *ctx = NULL;
+        emit(@{@"event": @"ready", @"protocol": @1, @"pid": @(getpid()), @"validate_only": @(validate_only),
+               @"features": @[@"face_refine", @"performance_controls_v1"]});
+        /* fgets bounds malformed/oversized input before any allocation or model load. */
+        char *line = malloc(REQUEST_LIMIT + 2);
+        if (!line) return 1;
+        while (fgets(line, REQUEST_LIMIT + 2, stdin)) {
+            @autoreleasepool {
+                size_t length = strlen(line);
+                if (length > REQUEST_LIMIT || !length || line[length - 1] != '\n') {
+                    emit(@{@"event": @"error", @"id": NSNull.null, @"message": @"request too large or incomplete"});
+                    break;
+                }
+                NSData *data = [NSData dataWithBytes:line length:length];
+                id request = [NSJSONSerialization JSONObjectWithData:data options:0 error:NULL];
+                if (![request isKindOfClass:NSDictionary.class] || !string_value(request[@"id"], YES)) {
+                    emit(@{@"event": @"error", @"id": NSNull.null, @"message": @"invalid request/id"});
+                    continue;
+                }
+                NSString *request_id = request[@"id"];
+                id command = request[@"command"];
+                if (![command isKindOfClass:NSString.class]) command = @"";
+                if ([command isEqualToString:@"quit"]) break;
+                if ([command isEqualToString:@"inspect"] || [command isEqualToString:@"clear"]) {
+                    if ([command isEqualToString:@"clear"]) h3_cache_clear(ctx);
+                    emit(@{@"event": @"cache", @"id": request_id, @"cache": cache_info(ctx)});
+                    continue;
+                }
+                h3_params params = H3_PARAMS_DEFAULT;
+                h3_reference refs[12] = {0};
+                NSString *error = [command isEqualToString:@"generate"] ?
+                    parse_request(request, &params, refs) : @"unknown command";
+                if (error) {
+                    emit(@{@"event": @"error", @"id": request_id, @"message": error});
+                    continue;
+                }
+                if (validate_only) {
+                    emit(@{@"event": @"validated", @"id": request_id, @"frames": @(params.frames),
+                           @"reference_count": @(params.reference_count), @"layers": @(params.dit_layers),
+                           @"reuse": @(params.denoise_reuse), @"ssd_streaming": @(params.ssd_streaming),
+                           @"reference_video_max_pixels": @(params.reference_video_max_pixels),
+                           @"refine": @(params.refine_video != NULL), @"refine_denoise": @(params.refine_denoise)});
+                    continue;
+                }
+                if ([[NSFileManager defaultManager] fileExistsAtPath:request[@"output"]]) {
+                    emit(@{@"event": @"error", @"id": request_id, @"message": @"output already exists"});
+                    continue;
+                }
+                if (!ctx) {
+                    ctx = h3_load_dir(argv[1]);
+                    if (ctx) h3_cache_set_enabled(ctx, 1);
+                }
+                if (!ctx) {
+                    emit(@{@"event": @"error", @"id": request_id,
+                           @"message": [NSString stringWithUTF8String:h3_last_error(NULL)]});
+                    continue;
+                }
+                if ([request[@"clear_cache"] isEqual:@YES]) h3_cache_clear(ctx);
+                params.on_progress = progress;
+                params.callback_opaque = (__bridge void *)request_id;
+                fprintf(stderr, "h3: workbench settings steps=%d layers=%d reuse=%d reference_video_max_pixels=%d ssd_streaming=%d\n",
+                        params.steps, params.dit_layers, params.denoise_reuse,
+                        params.reference_video_max_pixels, params.ssd_streaming);
+                h3_result *result = h3_generate(ctx, [request[@"prompt"] UTF8String], &params);
+                if (!result) {
+                    NSString *message = [NSString stringWithUTF8String:h3_last_error(ctx)];
+                    h3_cache_clear(ctx);
+                    emit(@{@"event": @"error", @"id": request_id, @"message": message});
+                } else {
+                    emit(@{@"event": @"done", @"id": request_id, @"output": request[@"output"],
+                           @"frames": @(result->frames), @"cache": cache_info(ctx)});
+                    h3_result_free(result);
+                }
+            }
+        }
+        free(line);
+        h3_free(ctx);
+    }
+    return 0;
+}
