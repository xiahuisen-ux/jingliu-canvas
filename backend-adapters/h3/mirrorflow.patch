diff --git a/h3_host.c b/h3_host.c
index a04a2a0..ea7e954 100644
--- a/h3_host.c
+++ b/h3_host.c
@@ -114,6 +114,29 @@ int h3_reference_video_canvas(int width, int height,
     return 1;
 }
 
+int h3_reference_video_canvas_capped(int width, int height, int max_pixels,
+                                     int *adapted_w, int *adapted_h) {
+    if (max_pixels < 0 || (max_pixels &&
+        (max_pixels < 32 * 32 || max_pixels > H3_MAX_PIXELS)) ||
+        !h3_reference_video_canvas(width, height, adapted_w, adapted_h)) return 0;
+    if (!max_pixels || (double)*adapted_w * *adapted_h <= max_pixels) return 1;
+    double scale = fmin(1.0, sqrt((double)max_pixels / ((double)width * height)));
+    int w = (int)fmax(32.0, nearbyint(width * scale / 32.0) * 32.0);
+    int h = (int)fmax(32.0, nearbyint(height * scale / 32.0) * 32.0);
+    int max_axis = (max_pixels / (32 * 32)) * 32;
+    if (w > max_axis) w = max_axis;
+    if (h > max_axis) h = max_axis;
+    /* Grid rounding must not silently exceed the memory budget. */
+    while ((double)w * h > max_pixels) {
+        if (w >= h && w > 32) w -= 32;
+        else if (h > 32) h -= 32;
+        else return 0;
+    }
+    *adapted_w = w;
+    *adapted_h = h;
+    return 1;
+}
+
 double h3_time_shift_sigma(double sigma, double from_shift, double to_shift) {
     double base = sigma / (from_shift + sigma * (1.0 - from_shift));
     return to_shift * base / (1.0 + (to_shift - 1.0) * base);
